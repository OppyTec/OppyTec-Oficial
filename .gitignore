# ==========================================
# OppyTec Monorepo — .gitignore
# ==========================================

# Repositorio legacy de consulta (se mantiene solo en local)
OppyTec-Legacy/

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.pem
*.key
google_credentials.json

# Python & Entornos Virtuales
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/

# Node & Frontend
node_modules/
.pnpm-store/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
*.local

# Tests, Cobertura y Linters
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/

# IDEs y Editores
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
