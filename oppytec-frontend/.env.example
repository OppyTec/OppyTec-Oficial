# ==============================================================================
# OppyTec SaaS v2.0 Frontend — Plantilla de Variables de Entorno (.env.example)
# Cero Secretos ni Credenciales Hardcodeadas.
# En contenedores (preview, staging, production), /docker-entrypoint.sh inyecta
# estas variables en /runtime-env.js preservando el mismo digest SHA-256.
# ==============================================================================

# 1. Identidad del Entorno y Namespace Efímero (Git Worktrees / PRs)
VITE_ENVIRONMENT=local
VITE_ENV_NAMESPACE=default

# 2. Endpoints de Backend API REST y Túnel WebSocket en Tiempo Real
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1/ws/realtime

# 3. Observabilidad 4-Pilares (OpenTelemetry, Sentry/GlitchTip y Umami Analytics)
VITE_SENTRY_DSN=
VITE_OTEL_COLLECTOR_URL=
VITE_UMAMI_ENABLED=false
VITE_UMAMI_WEBSITE_ID=

# 4. Marca Configurable del Asistente Cognitivo Sistema 2
VITE_AI_ASSISTANT_BRAND_NAME=OppyFy
