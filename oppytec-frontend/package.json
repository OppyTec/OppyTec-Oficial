{
  "name": "oppytec-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "OppyTec SaaS v2.0 Frontend — React 19 + TypeScript 5 Strict + ADN Visual Legacy (3 Temas) & Mobile-First",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
