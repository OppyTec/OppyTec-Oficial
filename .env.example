# =========================================================================
# OppyTec v2.0 - Variables de Entorno de Infraestructura y Docker Compose
# =========================================================================

# 1. Base de Datos y Caché
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_pass
POSTGRES_DB=oppytec_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# 2. Puertos de Servicios Locales
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 3. Observabilidad 4-Pilares (--profile observability)
GRAFANA_PORT=3001
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
UMAMI_PORT=3002
UMAMI_APP_SECRET=oppytec_local_umami_secret_32_chars_min
GLITCHTIP_PORT=3003
GLITCHTIP_SECRET_KEY=oppytec_local_glitchtip_secret_key_32_bytes

# 4. Observabilidad Especializada LLM (Langfuse v2 Self-Hosted)
LANGFUSE_PORT=3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-oppytec-dev-public-key
LANGFUSE_SECRET_KEY=sk-lf-oppytec-dev-secret-key-32
NEXTAUTH_SECRET=oppytec_langfuse_nextauth_secret_high_entropy_32
SALT=oppytec_langfuse_salt_key_min_16_chars
TELEMETRY_ENABLED=false
LANGFUSE_INIT_ORG_ID=oppytec-org
LANGFUSE_INIT_ORG_NAME=OppyTec
LANGFUSE_INIT_PROJECT_ID=oppytec-ai
LANGFUSE_INIT_PROJECT_NAME=OppyFy
LANGFUSE_ADMIN_PASSWORD=Admin123456789!
